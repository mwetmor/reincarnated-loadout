    {
      "abstained": 0,
      "anchor_quote": "Frozen Orb is the most iconic Sorceress spell — a spinning sphere of ice that constantly fires cold bolts in all directions as it travels, then explodes into a final burst on impact",
      "conf": 0.88,
      "created_date": "2026-07-18",
      "extraction_provenance": "fetched-vdm1",
      "family": "skill_loop",
      "id": 1447,
      "kit_id": "d2-frozen-orb-sorc",
      "payload_json": {
        "loop": "Cast Frozen Orb — projectile sphere travels forward firing cold bolt sprays in all directions continuously, then shatters into final burst at end of travel. Reposition via Teleport to manage distance and angles. Static Field to quickly lower boss HP. Ice Bolt / Blizzard as secondary. One-point Frozen Orb also viable early."
      },
      "source_url": "https://maxroll.gg/d2/guides/frozen-orb-sorceress"
    },
