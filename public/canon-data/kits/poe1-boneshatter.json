    {
      "abstained": 0,
      "anchor_quote": "Using this skill gives you up to 9 stacks of Trauma, each granting you extra damage. The Trauma counter resets upon reaching 10 stacks.",
      "conf": 0.93,
      "created_date": "2026-07-18",
      "extraction_provenance": "fetched-vdm1",
      "family": "skill_loop",
      "id": 85,
      "kit_id": "poe1-boneshatter",
      "payload_json": {
        "loop": "Direct melee strike on targeted enemy. Each successful attack grants one Trauma stack (up to 9; resets at 10). Each stack grants more physical damage AND deals self-damage equal to 194*(N+1) physical (pre-mitigation) on the next attack. Juggernaut sustains the self-damage via Untiring (regen scales with hits taken) and Endurance Charges. Unflinching ascendancy maintains Endurance Charge uptime via self-hits."
      },
      "source_url": "https://maxroll.gg/poe/build-guides/boneshatter-juggernaut-league-starter"
    },
